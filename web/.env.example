# Same database the Python server uses (Neon). Migrations are applied by the Python server.
DATABASE_URL=

# Shared with the Python server: SESSION_SECRET hashes login codes, CREDS_ENCRYPTION_KEY
# encrypts Kite access tokens. Both must be identical on both sides.
SESSION_SECRET=
CREDS_ENCRYPTION_KEY=

# The same Kite Connect app as the Python server. Its redirect URL must be
# <this app's origin>/api/broker/kite/callback
KITE_API_KEY=
KITE_API_SECRET=
#KITE_BASE_URL=https://api.kite.trade
#KITE_LOGIN_URL=https://kite.zerodha.com/connect/login

# Login-code email (https://resend.com). Unset: codes are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM=Zap <no-reply@example.com>

# Shown on the home page so users can add the connector to claude.ai.
NEXT_PUBLIC_MCP_URL=https://example.com/zap-kite-mcp/v1/mcp

# Development only: a fixed login that needs no email. Never set in production.
#DEV_LOGIN_EMAIL=
#DEV_LOGIN_CODE=
