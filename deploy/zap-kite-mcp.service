[Unit]
Description=zap-kite-mcp (Kite Connect sandbox MCP, watchers and web app)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=zapkite
Group=zapkite
WorkingDirectory=/opt/zap-kite-mcp/mcp
EnvironmentFile=/opt/zap-kite-mcp/.env
Environment=HOME=/var/lib/zapkite
ExecStartPre=/opt/zap-kite-mcp/mcp/.venv/bin/python -m zap_kite_mcp.sandbox
ExecStart=/opt/zap-kite-mcp/mcp/.venv/bin/zap-kite-mcp
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
InaccessiblePaths=-/var/www -/etc/nginx -/etc/letsencrypt -/opt/zap-claude-mcp -/opt/zap-eve-mcp
# /proc/sys/user: bwrap --disable-userns sets max_user_namespaces=0 for its child user namespace.
ReadWritePaths=/var/lib/zapkite /proc/sys/user
# AF_NETLINK: bwrap --unshare-net configures loopback inside the new network namespace.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
MemoryMax=1G
CPUQuota=200%
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
