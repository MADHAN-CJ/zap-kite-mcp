[Unit]
Description=Slash Markets Kite MCP (production)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=zapkiteprod
Group=zapkiteprod
WorkingDirectory=/opt/zap-kite-mcp-prod/mcp
EnvironmentFile=/opt/zap-kite-mcp-prod/.env
Environment=HOME=/var/lib/zapkiteprod
ExecStartPre=/opt/zap-kite-mcp-prod/mcp/.venv/bin/python -m zap_kite_mcp.sandbox
ExecStart=/opt/zap-kite-mcp-prod/mcp/.venv/bin/zap-kite-mcp
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
# No ProtectKernelTunables and no ReadWritePaths under /proc: both overmount paths inside /proc,
# and on kernel 6.8 (Ubuntu 24.04) a fresh procfs then cannot be mounted in bwrap's user
# namespace ("Can't mount proc on /newroot/proc"). The service runs unprivileged, so kernel
# tunables are not writable by it anyway. See SANDBOX.md.
ProtectKernelModules=true
ProtectControlGroups=true
InaccessiblePaths=-/var/www -/etc/nginx -/etc/letsencrypt -/opt/zap-claude-mcp -/opt/zap-eve-mcp
ReadWritePaths=/var/lib/zapkiteprod
# AF_NETLINK: bwrap --unshare-net configures loopback inside the new network namespace.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
MemoryMax=1G
CPUQuota=200%
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
