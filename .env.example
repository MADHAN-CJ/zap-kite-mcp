# One .env for both services: the Next.js app reads it from the repo root, the Python server
# via `npm run mcp` (uv run --directory mcp, which falls back to ../.env).

# Kite Connect app from https://developers.kite.trade (Connect plan: market data needs it).
# Its redirect URL points at the web app: <ZAP_KITE_MCP_APP_URL>/api/broker/kite/callback.
KITE_API_KEY=
KITE_API_SECRET=

# Postgres for users, sessions, OAuth state and watchers (Neon). Migrations run when the
# Python server boots; the web app only reads and writes.
DATABASE_URL=postgresql://user:password@host:5432/zap_kite_mcp

# Public base URL claude.ai uses (no trailing slash). Behind a path prefix, include it:
# https://example.com/zap-kite-mcp/v1
ZAP_KITE_MCP_PUBLIC_URL=http://127.0.0.1:8019
# The Next.js web app (web/) where users log in to Zerodha and manage watchers.
ZAP_KITE_MCP_APP_URL=http://127.0.0.1:3019
ZAP_KITE_MCP_HOST=127.0.0.1
ZAP_KITE_MCP_PORT=8019

# Random strings of at least 32 characters. Changing CREDS_ENCRYPTION_KEY invalidates every
# stored Kite session (users just log in again).
SESSION_SECRET=
CREDS_ENCRYPTION_KEY=

# Email for login codes and watcher alerts (https://resend.com). Unset: codes are logged.
RESEND_API_KEY=
EMAIL_FROM=Slash Markets <no-reply@example.com>

# Optional. Shared secret for POST /internal/sweep (forced sweeps from outside the process).
SWEEP_SECRET=
# Optional tuning (defaults shown).
#SWEEP_INTERVAL_SECONDS=60
#SCRIPT_TIMEOUT_SECONDS=60
#SCRIPT_MAX_TIMEOUT_SECONDS=180
#SCRIPT_MAX_OUTPUT_BYTES=65536
#MAX_CONCURRENT_RUNS=2
#ZAPKITE_CALL_BUDGET=40
#WATCHERS_MAX_ARMED=10
#WATCHERS_MIN_GAP_MINUTES=15
#ZAPKITE_RISK_FREE_RATE=0.07
#ZAP_KITE_MCP_STATE_DIR=~/.zap-kite-mcp
# Development only: a fixed login that needs no email. Never set these in production.
#DEV_LOGIN_EMAIL=
#DEV_LOGIN_CODE=

# --- Web app only ---
# Shown on the home page so users can add the connector to claude.ai.
NEXT_PUBLIC_MCP_URL=http://127.0.0.1:8019/
