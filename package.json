{
  "name": "zap-kite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3019",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run",
    "mcp": "uv run --directory mcp zap-kite-mcp",
    "mcp:check": "uv run --directory mcp ruff check . && uv run --directory mcp ruff format --check . && uv run --directory mcp mypy && uv run --directory mcp pytest",
    "mcp:smoke": "uv run --directory mcp python scripts/live_smoke.py",
    "deploy": "bash deploy/remote.sh deploy",
    "deploy:setup": "bash deploy/remote.sh setup",
    "logs": "bash deploy/remote.sh logs",
    "status": "bash deploy/remote.sh status"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "^6.0.10",
    "lucide-react": "1.16.0",
    "next": "16.2.6",
    "pg": "^8.22.0",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "24.x",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
