{
  "name": "zap-kite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3019",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run",
    "mcp": "uv run --directory mcp zap-kite-mcp",
    "mcp:check": "uv run --directory mcp ruff check . && uv run --directory mcp ruff format --check . && uv run --directory mcp mypy && uv run --directory mcp pytest",
    "mcp:smoke": "uv run --directory mcp python scripts/live_smoke.py",
    "deploy": "ssh root@64.227.149.33 'bash /root/zap-kite-mcp-deploy/update.sh'",
    "deploy:setup": "scp deploy/setup-uat.sh deploy/update.sh root@64.227.149.33:/root/zap-kite-mcp-deploy/ && ssh root@64.227.149.33 'bash /root/zap-kite-mcp-deploy/setup-uat.sh'",
    "logs": "ssh root@64.227.149.33 'journalctl -u zap-kite-mcp -n 100 --no-pager -o cat'",
    "status": "ssh root@64.227.149.33 'systemctl status zap-kite-mcp --no-pager; curl -fsS http://127.0.0.1:8019/health; echo'",
    "deploy:prod": "ssh root@168.144.85.144 'bash /root/zap-kite-prod-deploy/update-prod.sh'",
    "deploy:prod:setup": "scp deploy/setup-prod.sh root@168.144.85.144:/tmp/zap-kite-setup-prod.sh && ssh root@168.144.85.144 'bash /tmp/zap-kite-setup-prod.sh'",
    "logs:prod": "ssh root@168.144.85.144 'journalctl -u zap-kite-mcp-prod -n 100 --no-pager -o cat'",
    "status:prod": "ssh root@168.144.85.144 'systemctl status zap-kite-mcp-prod --no-pager && curl -fsS http://127.0.0.1:8019/health'",
    "plugin:openai:check": "python3 scripts/package_openai_plugin.py --check",
    "plugin:openai:build": "python3 scripts/package_openai_plugin.py",
    "plugin:openai:test": "python3 -m unittest discover -s scripts -p test_package_openai_plugin.py"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "^6.0.10",
    "lucide-react": "1.16.0",
    "next": "16.2.6",
    "pg": "^8.22.0",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "24.x",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
